# Copy to backend/.env (native development) or export these variables (Docker / hosting).
# Every value below is the default unless noted. Never commit a real .env file.

# development | test | production
GHOSTTRACE_ENVIRONMENT=development
GHOSTTRACE_LOG_LEVEL=INFO

# SQLite by default (file under backend/data/). PostgreSQL example:
# GHOSTTRACE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ghosttrace
# (requires: pip install "psycopg[binary]==3.3.6")
# GHOSTTRACE_DATABASE_URL=sqlite:///./data/ghosttrace.db
GHOSTTRACE_AUTO_MIGRATE=true

# Browser origins allowed to call the API (comma-separated).
GHOSTTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ingestion limits.
GHOSTTRACE_MAX_UPLOAD_BYTES=10485760
GHOSTTRACE_MAX_RECORDS_PER_IMPORT=50000
GHOSTTRACE_MAX_LINE_BYTES=65536
GHOSTTRACE_MAX_REPORTED_ERRORS=200
GHOSTTRACE_MAX_ATTRIBUTES_PER_EVENT=64

# Imports older than this many hours are deleted (0 disables cleanup).
GHOSTTRACE_RETENTION_HOURS=24

# Mutating requests per client per minute (0 disables). Per process, in memory.
GHOSTTRACE_RATE_LIMIT_PER_MINUTE=60
# Only behind a trusted reverse proxy that sets X-Forwarded-For.
GHOSTTRACE_TRUST_PROXY_HEADERS=false

GHOSTTRACE_ENABLE_DOCS=true
# Serve a built frontend from the API process (set automatically in the Docker image).
# GHOSTTRACE_STATIC_DIR=../frontend/dist

# ---- Optional AI explanations (off by default; the app works fully without them) ----
# none | anthropic   (requires: pip install "anthropic==1.13.0")
GHOSTTRACE_AI_PROVIDER=none
# Leave unset to let the Anthropic SDK read ANTHROPIC_API_KEY or an `ant auth login` profile.
# GHOSTTRACE_AI_API_KEY=
GHOSTTRACE_AI_MODEL=claude-opus-5-5
GHOSTTRACE_AI_TIMEOUT_SECONDS=60
GHOSTTRACE_AI_MAX_RETRIES=2
# When false, raw imported log messages are never sent to the provider.
GHOSTTRACE_AI_SEND_EVENT_MESSAGES=false

# ---- Frontend (only when the frontend is hosted separately from the API) ----
# VITE_API_BASE_URL=https://your-api.example.com
